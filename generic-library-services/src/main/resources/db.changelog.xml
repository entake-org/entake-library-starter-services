<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd"
>
    <changeSet id="1781117730876-1" author="entake">
        <createTable tableName="entake_submission" schemaName="library">
            <column name="submission_id" type="CHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="submission_locale" type="CHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="submission_status" type="CHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="submission_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="submission_user" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="decision_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="decision_owner" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="environment" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="form_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="form_version_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="form_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="received_time" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1781117730876-2" author="entake">
        <createTable tableName="entake_submission_data" schemaName="library">
            <column name="submission_id" type="CHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="data" type="MEDIUMTEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1781117730876-3" author="entake">
        <createTable tableName="entake_submission_document" schemaName="library">
            <column name="submission_document_id" type="CHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="submission_id" type="CHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
